VITE_SUPABASE_URL=https://npkidywzwddbnfrnxlmo.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=

# Optional local helper for deployed preview smoke commands. Not a secret.
CLOUDFLARE_PAGES_PREVIEW_URL=
# Optional compatibility alias for the preview URL.
PAGES_PREVIEW_URL=

# Local live admin QA only. Do not configure these in browser-facing production vars.
# First-admin email is for bootstrap/readiness checks; browser login/live-write QA uses URBLO_ADMIN_EMAIL.
URBLO_FIRST_ADMIN_EMAIL=
URBLO_ADMIN_EMAIL=
URBLO_ADMIN_PASSWORD=
URBLO_ADMIN_ACCESS_TOKEN=
# Separate active Editor account for the approval-gated Media Storage role-boundary proof.
URBLO_EDITOR_EMAIL=
URBLO_EDITOR_PASSWORD=
# Optional no-write QA account: valid Supabase Auth user with no active admin_profiles row.
URBLO_UNPROFILED_EMAIL=
URBLO_UNPROFILED_PASSWORD=

# Server-side only. Configure in Cloudflare Pages or a local untracked .env file.
SUPABASE_URL=https://npkidywzwddbnfrnxlmo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional compatibility alias used by the form Functions.
SUPABASE_SERVICE_KEY=
TURNSTILE_SECRET_KEY=
# Optional compatibility alias used by the form Functions.
CF_TURNSTILE_SECRET_KEY=
# Preferred Urblo email provider. Configure either SMTP2GO_API_KEY or RESEND_API_KEY.
SMTP2GO_API_KEY=
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM=
# Optional compatibility alias used by the form Functions.
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_TO=
ENQUIRY_NOTIFICATION_TO=
SAMPLE_REQUEST_NOTIFICATION_TO=
