# Urblo local container gate.
#
# Building this image IS the test: every quality gate runs as a build step, so
# `docker build` exits non-zero if build, lint, smoke, or the harness check
# fails. Invoked by `npm run gate` (scripts/container-gate.sh) before any push.
#
# The gate is source-only: .dockerignore excludes .env*, .dev.vars, and
# *.local so local secrets never enter the image and the build stays env-less,
# matching the Cloudflare Pages build it reproduces.
#
# Base image matches the Node 20 line used by .github/workflows/deploy.yml and
# the host. Bump them together, deliberately, and update
# docs/OPERATING_PROTOCOL.md to match.
FROM node:20-bookworm-slim

# Lets `npm run gate` prune superseded gate image layers safely.
LABEL urblo.gate="true"

WORKDIR /app

# Install dependencies as a cached layer (re-runs only when the lockfile
# changes); the npm cache mount persists across builds so lockfile changes
# avoid re-downloading the whole registry.
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

# Bring in the rest of the source. A source change invalidates the gate steps
# below — which is exactly what we want: the gates re-run on every real change.
COPY . .

# --- Quality gates ---
# `npm run build` runs `tsc -b && vite build`, so the typecheck gate lives
# inside the build step; a separate tsc run here would be a cached no-op.
RUN npm run build
RUN npm run lint
RUN npm run agent:smoke
RUN npm run agent:check
