      "references": [
        "docs/MAINTAINABILITY_AUDIT.md",
        "docs/architecture/platform.md"
      ],
      "checks": [
        "agent:check",
        "agent:harness-gc"
      ]
    },
    "delivery": {
      "paths": [
        ".github/workflows/deploy.yml",
        "Dockerfile.gate",
        "scripts/container-gate.sh"
      ],
      "rules": [
        "docs/agent/verification.md",
        "docs/architecture/delivery.md"
      ],
      "references": [
        "docs/CLOUDFLARE_DEPLOYMENT.md",
        "docs/LOCAL_DEVELOPMENT.md",
        "docs/agent/live-verification.md",
        "docs/architecture/platform.md"
      ],
      "checks": [
        "agent:cloudflare-readiness",
        "agent:cloudflare-preview-smoke",
        "agent:doctor",
        "local:verify"
      ]
    },
    "qr": {
      "paths": [
        "src/pages/admin/AdminImageQrPage.tsx",
        "src/pages/ImageQrPage.tsx",
