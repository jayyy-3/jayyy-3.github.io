      "rules": [
        "docs/architecture/media.md"
      ],
      "references": [
        "docs/ADMIN_IA_ACCESS.md",
        "docs/SUPABASE_SCHEMA.md"
      ],
      "checks": [
        "agent:admin-crud-coverage",
        "agent:admin-media-role-boundary-live"
      ]
    },
    "auth-settings": {
      "paths": [
        "src/lib/supabaseClient.ts",
        "src/lib/adminAuth.tsx",
        "src/pages/admin/AdminSettingsPage.tsx"
      ],
      "rules": [
        "docs/architecture/auth-settings.md",
        "docs/architecture/admin-cms.md"
      ],
      "references": [
        "docs/ADMIN_IA_ACCESS.md",
        "docs/ADMIN_EDITOR_GUIDE.md",
        "docs/ADMIN_OPERATIONS_RUNBOOK.md"
      ],
      "checks": [
        "agent:admin-config-gate",
        "agent:admin-auth-browser",
        "agent:admin-guide"
      ]
    },
    "public-ui": {
      "paths": [
        "src/App.tsx",
        "src/components/site",
        "src/layouts"
      ],
      "rules": [
        "docs/architecture/public-routes.md",
        "docs/architecture/public-metadata.md"
      ],
      "references": [
        "docs/architecture/homepage.md",
        "docs/DESIGN.md",
        "docs/brand-baseline.md",
        "docs/architecture/public-media.md"
      ],
      "checks": [
        "agent:smoke"
      ]
    }
  }
}
