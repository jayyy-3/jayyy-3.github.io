      "paths": [
        "src/pages/admin/AdminProductsPage.tsx",
        "src/service/ProductService.ts"
      ],
      "rules": [
        "docs/architecture/products.md"
      ],
      "references": [
        "docs/DESIGN.md",
        "docs/architecture/content-data.md"
      ],
      "checks": [
        "agent:product-model-images",
        "agent:public-content-overlay"
      ]
