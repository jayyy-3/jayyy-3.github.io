      "rules": [
        "docs/architecture/projects.md",
        "docs/architecture/projects-admin.md"
      ],
      "references": [
        "docs/ADMIN_IA_ACCESS.md",
        "docs/architecture/content-data.md",
        "docs/SUPABASE_SCHEMA.md"
      ],
      "checks": [
        "agent:admin-projects-aggregate",
        "agent:public-content-overlay"
      ]
