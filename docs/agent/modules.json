{
  "version": 1,
  "modules": {
    "harness": {
      "paths": [
        "AGENTS.md",
        "docs/agent",
        "scripts/agent-init.sh",
        "scripts/check-harness.mjs"
      ],
      "rules": [
        "docs/OPERATING_PROTOCOL.md",
